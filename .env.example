# Configure one or both LLM API keys beforehand on the server/environment.
# Copy or rename this file to `.env` (gitignored) or place keys in `.streamlit/secrets.toml`.
# Default models are selected automatically (Gemini: gemini-3.8-flash, OpenAI: gpt-4o-mini).
#
# Where to get API keys:
#   Google Gemini (free tier available): https://aistudio.google.com/apikey
#   OpenAI: https://platform.openai.com/api-keys

GEMINI_API_KEY=
OPENAI_API_KEY=
